---
import BaseHead from '../components/BaseHead.astro';
import RecipeHeader from '../components/cookbook/RecipeHeader.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

interface Props {
	title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={title + " | Coffey Cookbook"} description={"A personal recipe collection"} />
	</head>
	<body class="bg-slate-50 text-slate-800 dark:bg-slate-900 dark:text-slate-200">
		<RecipeHeader />
		
		<main class="transition-all duration-300 ease-in-out">
			<div class="container mx-auto p-4 md:py-8">
				<slot />
			</div>
		</main>
		
		<Footer />
	</body>
</html>