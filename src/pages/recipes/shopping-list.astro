---
import Layout from '../../layouts/Layout.astro';
import ShoppingList from '../../components/recipes/ShoppingList.jsx';
import ActiveList from '../../components/recipes/ActiveList.jsx';
import type { Recipe } from '../../types';

const allJsonFiles = await import.meta.glob('/src/content/recipes/*.json');
const allRecipes = (await Promise.all(
  Object.values(allJsonFiles).map(async (getJson) =>
    (await getJson() as { default: Recipe[] }).default
  )
)).flat();
---

<Layout title="Shopping List">
  <main class="container mx-auto p-4 max-w-2xl">
    <h1 class="text-4xl font-bold mb-8">Shopping List 🛒</h1>
    
    <ShoppingList allRecipes={allRecipes} client:load />
  </main>

  <br><hr><br>

  <main class="container mx-auto p-4">
    <h1 class="text-4xl font-bold mb-8">Your Active Recipes</h1>

    <ActiveList allRecipes={allRecipes} client:load />
  </main>
</Layout>