---
interface Props {
	beforeImage: string;
	afterImage: string;
	alt: string;
	beforeText?: string;
	afterText?: string;
}

const { beforeImage, afterImage, alt, beforeText = 'Before', afterText = 'After' } = Astro.props;

const beforePath = `/images/projects/${beforeImage}`;
const afterPath = `/images/projects/${afterImage}`;
---

<div class="image-slider-wrapper my-8 aspect-video rounded-lg overflow-hidden select-none" data-testid="image-slider">
	<img src={afterPath} alt={alt} class="slider-image" loading="lazy" draggable="false" />
	<div class="slider-text-overlay">
		<span class="slider-text slider-text-after">{afterText}</span>
	</div>

	<div class="slider-clipped-image" style="width: 50%;">
		{/* The key change is adding the 'slider-image-before' class here */}
		<img src={beforePath} alt={alt} class="slider-image slider-image-before" loading="lazy" draggable="false" />
		<div class="slider-text-overlay">
			<span class="slider-text slider-text-before">{beforeText}</span>
		</div>
	</div>

	<div class="slider-line" style="left: 50%;">
		<div class="slider-handle">
			<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="currentColor" viewBox="0 0 16 16">
				<path d="M7 2a1 1 0 1 1-2 0 1 1 0 0 1 2 0m3 0a1 1 0 1 1-2 0 1 1 0 0 1 2 0M7 5a1 1 0 1 1-2 0 1 1 0 0 1 2 0m3 0a1 1 0 1 1-2 0 1 1 0 0 1 2 0M7 8a1 1 0 1 1-2 0 1 1 0 0 1 2 0m3 0a1 1 0 1 1-2 0 1 1 0 0 1 2 0m-3 3a1 1 0 1 1-2 0 1 1 0 0 1 2 0m3 0a1 1 0 1 1-2 0 1 1 0 0 1 2 0"/>
			</svg>
		</div>
	</div>
</div>

<style>
	.image-slider-wrapper {
		position: relative;
		cursor: ew-resize;
	}
	.slider-image {
		position: absolute;
		top: 0;
		left: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
		pointer-events: none;
	}
	.slider-image-before {
		object-position: left center;
	}
	.slider-clipped-image {
		position: absolute;
		top: 0;
		left: 0;
		height: 100%;
		overflow: hidden;
	}
	.slider-line {
		position: absolute;
		top: 0;
		bottom: 0;
		width: 4px;
		background-color: rgba(0, 0, 0, 0.7);
		transform: translateX(-50%);
		pointer-events: none;
	}
	.slider-handle {
		position: absolute;
		top: 50%;
		left: 50%;
		transform: translate(-50%, -50%);
		width: 40px;
		height: 40px;
		background-color: rgba(0, 0, 0, 0.7);
		border-radius: 50%;
		display: flex;
		align-items: center;
		justify-content: center;
		color: white;
	}
	.slider-text-overlay {
		position: absolute;
		bottom: 0;
		left: 0;
		right: 0;
		height: 4rem;
		background: linear-gradient(to top, rgba(0, 0, 0, 0.5), transparent);
		opacity: 0;
		transition: opacity 0.3s ease;
		pointer-events: none;
	}
	.image-slider-wrapper:hover .slider-text-overlay {
		opacity: 1;
	}
	.slider-text {
		position: absolute;
		bottom: 0.75rem;
		color: white;
		font-size: 1rem;
		font-weight: 600;
		text-shadow: 1px 1px 3px rgba(0, 0, 0, 0.7);
		white-space: nowrap;
	}
	.slider-text-before {
		left: 1.5rem;
	}
	.slider-text-after {
		right: 1.5rem;
	}
</style>

<script>
	document.querySelectorAll('[data-testid="image-slider"]').forEach(wrapper => {
		let isDragging = false;
		
		const clippedImage = wrapper.querySelector('.slider-clipped-image');
		const sliderLine = wrapper.querySelector('.slider-line');

		const startDragging = () => { isDragging = true; };
		const stopDragging = () => { isDragging = false; };

		const onDrag = (e) => {
			if (!isDragging) return;

			const rect = wrapper.getBoundingClientRect();
			let offsetX = e.clientX - rect.left;
			if (e.touches) {
				offsetX = e.touches[0].clientX - rect.left;
			}
			
			const position = Math.max(0, Math.min(offsetX, rect.width));
			const percentage = (position / rect.width) * 100;
			
			clippedImage.style.width = `${percentage}%`;
			sliderLine.style.left = `${percentage}%`;
		};

		wrapper.addEventListener('mousedown', startDragging);
		window.addEventListener('mouseup', stopDragging);
		window.addEventListener('mousemove', onDrag);
		wrapper.addEventListener('touchstart', startDragging, { passive: true });
		window.addEventListener('touchend', stopDragging);
		window.addEventListener('touchmove', onDrag, { passive: true });
	});
</script>