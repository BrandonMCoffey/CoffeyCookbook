---
interface Props {
  file: string;
  alt?: string;
  file2?: string;
  alt2?: string;
}

const { file, alt = '', file2, alt2 = '' } = Astro.props;

const imagePath = `/images/projects/${file}`;
const defaultImagePath = '/images/default.jpg';

const gridCols = file2 ? 'grid-cols-1 sm:grid-cols-2' : 'grid-cols-1';
---

<div class={`my-8 grid ${gridCols} gap-4`}>
  <div class="relative group">
    <img
      src={imagePath}
      alt={alt}
      class="overflow-hidden rounded-lg shadow-lg w-full h-full object-cover"
      loading="lazy"
      decoding="async"
      onerror={`this.onerror=null; this.src='${defaultImagePath}';`}
    />
    <button class="open-lightbox-btn" title="View image fullscreen" data-src={imagePath} data-alt={alt}>
      <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-5 h-5"><path stroke-linecap="round" stroke-linejoin="round" d="M3.75 3.75v4.5m0-4.5h4.5m-4.5 0L9 9M3.75 20.25v-4.5m0 4.5h4.5m-4.5 0L9 15M20.25 3.75h-4.5m4.5 0v4.5m0-4.5L15 9m4.5 11.25h-4.5m4.5 0v-4.5m0 4.5L15 15"></path></svg>
    </button>
  </div>
  {file2 && (
    <div class="relative group">
      <img
        src={`/images/projects/${file2}`}
        alt={alt2}
        class="overflow-hidden rounded-lg shadow-lg w-full h-full object-cover"
        loading="lazy"
        decoding="async"
        onerror={`this.onerror=null; this.src='${defaultImagePath}';`}
      />
      <button class="open-lightbox-btn" title="View image fullscreen" data-src={`/images/projects/${file2}`} data-alt={alt2}>
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-5 h-5"><path stroke-linecap="round" stroke-linejoin="round" d="M3.75 3.75v4.5m0-4.5h4.5m-4.5 0L9 9M3.75 20.25v-4.5m0 4.5h4.5m-4.5 0L9 15M20.25 3.75h-4.5m4.5 0v4.5m0-4.5L15 9m4.5 11.25h-4.5m4.5 0v-4.5m0 4.5L15 15"></path></svg>
      </button>
    </div>
  )}
</div>

<style>
  .open-lightbox-btn {
    @apply absolute bottom-3 right-3 h-10 w-10 bg-slate-900/50 text-white backdrop-blur-sm rounded-full flex items-center justify-center opacity-0 group-hover:opacity-100 transition-opacity duration-300;
  }
</style>

<script>
  function createLightbox() {
    if (document.getElementById('image-lightbox')) return;

    const lightboxHTML = `
      <div id="image-lightbox" class="lightbox-overlay">
        <div class="lightbox-content">
          <img class="lightbox-image" src="" alt="">
          <button class="lightbox-btn lightbox-fullscreen-btn" title="Enter fullscreen">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-6 h-6"><path stroke-linecap="round" stroke-linejoin="round" d="M3.75 3.75v4.5m0-4.5h4.5m-4.5 0L9 9M3.75 20.25v-4.5m0 4.5h4.5m-4.5 0L9 15M20.25 3.75h-4.5m4.5 0v4.5m0-4.5L15 9m4.5 11.25h-4.5m4.5 0v-4.5m0 4.5L15 15" /></svg>
          </button>
          <button class="lightbox-btn lightbox-close-btn" title="Close (Esc)">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-6 h-6"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12" /></svg>
          </button>
        </div>
      </div>
    `;
    document.body.insertAdjacentHTML('beforeend', lightboxHTML);

    const lightbox = document.getElementById('image-lightbox');
    const lightboxImage = lightbox?.querySelector('.lightbox-image') as HTMLImageElement | null;
    const closeBtn = lightbox?.querySelector('.lightbox-close-btn');
    const fullscreenBtn = lightbox?.querySelector('.lightbox-fullscreen-btn');

    if (!lightbox || !lightboxImage || !closeBtn || !fullscreenBtn) {
      console.error('Lightbox elements could not be found.');
      return;
    }

    const closeLightbox = () => {
      document.body.classList.remove('lightbox-open');
      if (document.fullscreenElement) {
        document.exitFullscreen();
      }
    };
    
    const handleKeyDown = (e: KeyboardEvent) => {
      if (e.key === 'Escape') {
        closeLightbox();
      }
    };

    closeBtn.addEventListener('click', closeLightbox);
    lightbox.addEventListener('click', (e) => {
      if (e.target === lightbox) {
        closeLightbox();
      }
    });

    fullscreenBtn.addEventListener('click', () => {
      if (!document.fullscreenElement) {
        lightboxImage.requestFullscreen();
      } else {
        document.exitFullscreen();
      }
    });
    
    document.addEventListener('open-lightbox', (e: Event) => {
      const { src, alt } = (e as CustomEvent).detail;
      lightboxImage.src = src;
      lightboxImage.alt = alt;
      document.body.classList.add('lightbox-open');
      document.addEventListener('keydown', handleKeyDown, { once: true });
    });
  }

  createLightbox();

  document.querySelectorAll('.open-lightbox-btn').forEach(button => {
    button.addEventListener('click', (e: Event) => {
      const currentButton = e.currentTarget as HTMLButtonElement | null;
      if (!currentButton) return;

      const { src, alt } = currentButton.dataset;
      const openEvent = new CustomEvent('open-lightbox', { detail: { src, alt } });
      document.dispatchEvent(openEvent);
    });
  });
</script>