---
import { getCollection } from 'astro:content';
import ProjectCard from '../projects/ProjectCard.astro';
import SectionWrapper from './SectionWrapper.astro';

const allProjects = await getCollection('projects');
const featuredProjects = allProjects
  .filter(project => project.data.filters?.includes('featured'))
  .sort((a, b) => a.data.priority - b.data.priority);
---
<SectionWrapper id="projects" title="Featured Projects">
	<div class="grid grid-cols-1 gap-8 md:grid-cols-2 lg:grid-cols-3">
		{featuredProjects.map(project => (
			<ProjectCard project={project} />
		))}
	</div>
  <div class="mt-12 text-center">
    <a href="/projects" class="btn btn-secondary">View All Projects</a>
  </div>
</SectionWrapper>